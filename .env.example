POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Admin OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube upload (server-side uploads to the EBB channel).
# Client id/secret come from a Google OAuth client (YouTube Data API v3 enabled).
# Generate the refresh token once with: python scripts/get_youtube_refresh_token.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# HS256 secret for admin session JWTs — generate with: openssl rand -hex 32
JWT_SECRET=

# URLs used in OAuth redirects
BACKEND_URL=
FRONTEND_URL=

# Admin access is database-driven (a user row with is_admin=true), not env-based.
# Bootstrap the first admin on a fresh DB with seed_admin.py — optionally read from here:
#   docker compose exec backend python seed_admin.py
BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=  # optional; not needed for Google sign-in
